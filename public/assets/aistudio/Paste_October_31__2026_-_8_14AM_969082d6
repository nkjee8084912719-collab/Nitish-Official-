// ---------------- CREATE LIVE PAGE ----------------

class CreateLivePage extends StatefulWidget {
  const CreateLivePage({super.key});

  @override
  State<CreateLivePage> createState() => _CreateLivePageState();
}

class _CreateLivePageState extends State<CreateLivePage> {
  final nameController = TextEditingController();
  final topicController = TextEditingController();
  final capacityController = TextEditingController(text: '50');
  bool isPublic = true;

  @override
  void dispose() {
    nameController.dispose();
    topicController.dispose();
    capacityController.dispose();
    super.dispose();
  }

  void create() {
    final name = nameController.text.trim();
    final topic = topicController.text.trim();
    final capacity = int.tryParse(capacityController.text.trim()) ?? 0;

    if (name.isEmpty || topic.isEmpty || capacity < 2 || capacity > 100) {
      showMessage(context, 'Enter room details. Capacity must be 2–100.');
      return;
    }

    Navigator.pop(
      context,
      LiveRoom(
        name: name,
        host: 'You',
        topic: topic,
        isPublic: isPublic,
        capacity: capacity,
        members: 1,
        memberNames: ['You'],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Create Live Room')),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          const Icon(Icons.live_tv, size: 65, color: pink),
          const SizedBox(height: 20),
          TextField(
            controller: nameController,
            decoration: const InputDecoration(
              labelText: 'Room Name',
              border: OutlineInputBorder(),
            ),
          ),
          const SizedBox(height: 15),
          TextField(
            controller: topicController,
            decoration: const InputDecoration(
              labelText: 'Room Topic',
              border: OutlineInputBorder(),
            ),
          ),
          const SizedBox(height: 15),
          TextField(
            controller: capacityController,
            keyboardType: TextInputType.number,
            decoration: const InputDecoration(
              labelText: 'Maximum Members (2–100)',
              border: OutlineInputBorder(),
            ),
          ),
          const SizedBox(height: 20),
          const Text(
            'Room Privacy',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          RadioListTile<bool>(
            value: true,
            groupValue: isPublic,
            onChanged: (v) => setState(() => isPublic = v!),
            title: const Text('Public Room'),
          ),
          RadioListTile<bool>(
            value: false,
            groupValue: isPublic,
            onChanged: (v) => setState(() => isPublic = v!),
            title: const Text('Private Room'),
          ),
          const SizedBox(height: 20),
          SizedBox(
            height: 50,
            child: ElevatedButton.icon(
              onPressed: create,
              icon: const Icon(Icons.wifi_tethering),
              label: const Text('Create Live'),
            ),
          ),
        ],
      ),
    );
  }
}

// ---------------- ROOM DETAILS & HOST CONTROLS ----------------

class RoomPage extends StatefulWidget {
  final LiveRoom room;
  final String currentUser;
  final VoidCallback onChanged;
  final VoidCallback onEnded;

  const RoomPage({
    super.key,
    required this.room,
    required this.currentUser,
    required this.onChanged,
    required this.onEnded,
  });

  @override
  State<RoomPage> createState() => _RoomPageState();
}

class _RoomPageState extends State<RoomPage> {
  bool joined = false;
  bool muted = false;

  bool get isHost => widget.room.host == widget.currentUser ||
      (widget.room.host == 'You' && widget.currentUser.isNotEmpty);

  void joinRoom() {
    if (widget.room.members >= widget.room.capacity) {
      showMessage(context, 'Room is full.');
      return;
    }

    if (!widget.room.isPublic && widget.room.host != 'You') {
      showMessage(context, 'Private room: host permission required.');
      return;
    }

    setState(() {
      joined = true;
      widget.room.members++;
      widget.room.memberNames.add(widget.currentUser);
    });
    widget.onChanged();
  }

  void leaveRoom() {
    if (!joined) return;

    setState(() {
      joined = false;
      widget.room.members--;
      widget.room.memberNames.remove(widget.currentUser);
    });
    widget.onChanged();
  }

  void hostAction(String action) {
    showMessage(context, '$action: Demo action selected.');
  }

  @override
  Widget build(BuildContext context) {
    final room = widget.room;

    return Scaffold(
      appBar: AppBar(
        title: Text(room.name),
        actions: [
          if (isHost)
            IconButton(
              icon: const Icon(Icons.settings),
              onPressed: () {
                showModalBottomSheet(
                  context: context,
                  builder: (_) => hostPanel(),
                );
              },
            ),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          Container(
            height: 130,
            decoration: BoxDecoration(
              gradient: const LinearGradient(
                colors: [pink, Colors.deepPurple],
              ),
              borderRadius: BorderRadius.circular(18),
            ),
            child: const Center(
              child: Icon(Icons.groups, size: 75),
            ),
          ),
          const SizedBox(height: 20),
          Text(
            room.name,
            style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
          ),
          Text('Topic: ${room.topic}'),
          Text('Host: ${room.host}'),
          Text('Privacy: ${room.isPublic ? 'Public' : 'Private'}'),
          Text('Members: ${room.members}/${room.capacity}'),
          const SizedBox(height: 20),
          const Text(
            'Room Members',
            style: TextStyle(fontSize: 19, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 10),
          ...room.memberNames.map(
            (member) => Card(
              color: panel,
              child: ListTile(
                leading: const CircleAvatar(child: Icon(Icons.person)),
                title: Text(member),
                subtitle: Text(member == room.host ? 'Host' : 'Member'),
                trailing: isHost && member != room.host
                    ? IconButton(
                        icon: const Icon(Icons.person_remove),
                        onPressed: () {
                          setState(() {
                            room.memberNames.remove(member);
                            room.members--;
                          });
                          widget.onChanged();
                        },
                      )
                    : null,
              ),
            ),
          ),
          const SizedBox(height: 20),
          if (!joined && !isHost)
            ElevatedButton(
              onPressed: joinRoom,
              child: const Text('Join Room'),
            ),
          if (joined)
            ElevatedButton(
              onPressed: leaveRoom,
              child: const Text('Leave Room'),
            ),
          if (isHost) ...[
            const Divider(height: 35),
            const Text(
              'Host Dashboard',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                actionButton('Co-host', Icons.star),
                actionButton('Moderator', Icons.shield),
                actionButton('Mute', Icons.mic_off),
                actionButton('Invite', Icons.person_add),
              ],
            ),
            const SizedBox(height: 15),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
              onPressed: () {
                widget.onEnded();
                Navigator.pop(context);
              },
              child: const Text('End Live Room'),
            ),
          ],
        ],
      ),
    );
  }

  Widget actionButton(String label, IconData icon) {
    return OutlinedButton.icon(
      onPressed: () => hostAction(label),
      icon: Icon(icon, size: 18),
      label: Text(label),
    );
  }

  Widget hostPanel() {
    return SafeArea(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text(
              'Host Controls',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            ListTile(
              leading: const Icon(Icons.star),
              title: const Text('Assign Co-host'),
              onTap: () {
                Navigator.pop(context);
                hostAction('Assign Co-host');
              },
            ),
            ListTile(
              leading: const Icon(Icons.shield),
              title: const Text('Assign Moderator'),
              onTap: () {
                Navigator.pop(context);
                hostAction('Assign Moderator');
              },
            ),
            ListTile(
              leading: const Icon(Icons.mic_off),
              title: const Text('Mute Room'),
              onTap: () {
                Navigator.pop(context);
                setState(() => muted = !muted);
                hostAction(muted ? 'Room muted' : 'Room unmuted');
              },
            ),
          ],
        ),
      ),
    );
  }
}

