class LiveRoom {
  String name;
  String host;
  String topic;
  bool isPublic;
  int capacity;
  int members;
  bool isActive;
  bool isMuted;
  List<String> memberNames;

  LiveRoom({
    required this.name,
    required this.host,
    required this.topic,
    required this.isPublic,
    required this.capacity,
    this.members = 1,
    this.isActive = true,
    this.isMuted = false,
    List<String>? memberNames,
  }) : memberNames = memberNames ?? [host];
}

